# ============================================================
# Credit Risk Support System - Niên luận KTPM
# Sao chép file này thành .env trước khi chạy docker compose
# Dữ liệu demo là dữ liệu mô phỏng, không phải dữ liệu khách hàng thật
# ============================================================

# PostgreSQL
POSTGRES_USER=credit_user
POSTGRES_PASSWORD=credit_password_demo
POSTGRES_DB=credit_risk
POSTGRES_HOST=postgres
POSTGRES_PORT=5432

# Backend database URL (PostgreSQL trong Docker)
DATABASE_URL=postgresql+psycopg2://credit_user:credit_password_demo@postgres:5432/credit_risk

# SQLite cho môi trường demo local (thay DATABASE_URL nếu không dùng PostgreSQL)
# DATABASE_URL=sqlite:///./credit_risk_demo.db

# JWT
JWT_SECRET_KEY=change-this-demo-secret-key-not-for-production
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=480

# CORS (frontend)
CORS_ORIGINS=http://localhost:3000,http://localhost:5173,http://127.0.0.1:3000,http://127.0.0.1:5173

# Service URLs
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
ML_SERVICE_URL=http://ml-service:8001
ML_SERVICE_HOST=0.0.0.0
ML_SERVICE_PORT=8001
FRONTEND_PORT=3000

# Risk scoring (điểm tín dụng mô phỏng)
CREDIT_SCORE_MAX=850
CREDIT_SCORE_RANGE=550
LOW_RISK_THRESHOLD=0.20
MEDIUM_RISK_THRESHOLD=0.45

# Admin mặc định (dùng bởi script seed)
ADMIN_EMAIL=admin@credit-risk.com
ADMIN_PASSWORD=Admin@123456
ADMIN_FULL_NAME=Quản trị hệ thống

# Frontend
VITE_API_BASE_URL=http://localhost:8000
